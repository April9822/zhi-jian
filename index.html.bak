<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>知间 InBetween — 理解人与人之间</title>
  <link rel="stylesheet" href="/src/style.css" />
</head>
<body>
  <div id="app">

    <main id="intro-screen" class="screen active intro-screen">
      <canvas id="skyCanvas"></canvas>
      <canvas id="starCanvas"></canvas>
      <div class="scene-stage">

        <!-- Scene 1: 0-4s -->
        <div class="scene s1" style="animation-delay:0s">
          <p class="sl" style="animation-delay:0.2s"><span style="font-size:36px;font-weight:500;opacity:1">你来了……</span></p>
          <p class="sl" style="animation-delay:1.3s"><span style="font-size:22px;font-weight:400;opacity:0.65">我是</span><span class="kw" style="font-size:24px;font-weight:500;opacity:0.85">「知间」</span></p>
        </div>

        <!-- Scene 2: 4.8-8s -->
        <div class="scene s2" style="animation-delay:4.0s">
          <p class="sl" style="animation-delay:0s">
            <span style="font-size:25px;font-weight:400;opacity:0.7">刚才那场</span>
            <span class="kw" style="font-size:34px;font-weight:500;opacity:1">不愉快</span>
            <span style="font-size:25px;font-weight:400;opacity:0.7">的</span>
            <span class="kw" style="font-size:34px;font-weight:500;opacity:1">对话</span>
          </p>
          <p class="sl" style="animation-delay:1.5s">
            <span style="font-size:24px;font-weight:400;opacity:0.75">是不是还留在</span>
            <span class="kw" style="font-size:34px;font-weight:500;opacity:1">心里</span>
          </p>
        </div>

        <!-- Scene 3: 9.5-14s -->
        <div class="scene s3" style="animation-delay:8.0s">
          <p class="sl" style="animation-delay:0s">
            <span style="font-size:20px;font-weight:400;opacity:0.65">有些话</span>
          </p>
          <p class="sl" style="animation-delay:0s">
            <span style="font-size:26px;font-weight:400;opacity:0.8">说出口以后</span>
          </p>
          <p class="sl" style="animation-delay:2.0s">
            <span style="font-size:24px;font-weight:400;opacity:0.85">留下的是</span>
            <span class="kw" style="font-size:36px;font-weight:500;opacity:1">伤害</span>
          </p>
          <p class="sl" style="animation-delay:3.0s">
            <span style="font-size:24px;font-weight:400;opacity:0.85">也藏着没有说出的</span>
            <span class="kw" style="font-size:38px;font-weight:500;opacity:1">在乎</span>
          </p>
        </div>

        <!-- Scene 4: 15.5-20s 品牌核心 -->
        <div class="scene s4" style="animation-delay:13.5s">
          <p class="sl" style="animation-delay:0s">
            <span style="font-size:20px;font-weight:400;opacity:0.55">很多冲突</span>
          </p>
          <p class="sl" style="animation-delay:0s">
            <span style="font-size:24px;font-weight:400;opacity:0.7">都不是从</span>
            <span class="kw" style="font-size:34px;font-weight:500;opacity:0.9">争吵</span>
            <span style="font-size:24px;font-weight:400;opacity:0.7">开始</span>
          </p>
          <p class="sl" style="animation-delay:2.0s">
            <span style="font-size:24px;font-weight:400;opacity:0.85">而是因为</span>
          </p>
          <p class="sl" style="animation-delay:3.0s">
            <span style="font-size:36px;font-weight:500;opacity:1">没有被</span>
            <span class="kw breathe" style="font-size:44px;font-weight:600;opacity:1">理解</span>
          </p>
        </div>

        <!-- Scene 5: 21-25s -->
        <div class="scene s5" style="animation-delay:19.0s">
          <p class="sl" style="animation-delay:0s">
            <span style="font-size:24px;font-weight:400;opacity:0.65">让我</span>
            <span class="kw" style="font-size:38px;font-weight:500;opacity:1">陪你</span>
          </p>
          <p class="sl" style="animation-delay:1.2s">
            <span class="kw" style="font-size:34px;font-weight:500;opacity:1">听懂</span>
          </p>
          <p class="sl" style="animation-delay:2.4s">
            <span style="font-size:24px;font-weight:400;opacity:0.85">那份情绪背后的</span>
            <span class="kw" style="font-size:38px;font-weight:500;opacity:1">在乎</span>
          </p>
        </div>

        <!-- Scene 6: 25-28s -->
        <div class="scene s6" style="animation-delay:22.5s">
          <p class="sl" style="animation-delay:0s"><span style="font-size:22px;font-weight:400;opacity:0.65">如果你愿意</span></p>
          <p class="sl" style="animation-delay:1s">
            <span style="font-size:28px;font-weight:400;opacity:0.8">我们一起</span>
            <span class="kw" style="font-size:38px;font-weight:500;opacity:1">看看</span>
          </p>
        </div>

        <div id="transition-msg" class="scene transition-msg">
          <p>我在听……</p>
        </div>

      </div>

      <div class="scene-buttons">
        <button class="intro-btn primary" onclick="window.goToInput(event)">开始倾诉</button>
        <button class="intro-btn secondary" onclick="window.goToSpace(event)">以后再说</button>
      </div>
    </main>

    <!-- ====== 知间空间 ====== -->
    <main id="space-screen" class="screen">
      <canvas id="warmCanvas"></canvas>
      <div class="space-container">
        <!-- ① 品牌 Hero -->
        <div class="space-hero">
          <h1 class="space-brand">知间</h1>
          <p class="space-subtitle">你的关系花园</p>
          <p class="space-desc">每一次沟通，都在滋养一段关系。</p>
        </div>

        <!-- ② 你能收获什么 -->
        <div class="space-section">
          <h2 class="space-section-title">你能收获什么</h2>
          <div class="benefit-grid">
            <div class="benefit-card">
              <img class="space-card-icon" src="/icon-understand.png" alt="" width="32" height="32">
              <h3>读懂每句话</h3>
              <p>不是判断对错，是看见对方真正想说什么</p>
            </div>
            <div class="benefit-card">
              <img class="space-card-icon" src="/icon-change.png" alt="" width="32" height="32">
              <h3>看见关系变化</h3>
              <p>一周后、一个月后，这段关系在变好还是变远</p>
            </div>
            <div class="benefit-card">
              <img class="space-card-icon" src="/icon-translate.png" alt="" width="32" height="32">
              <h3>温柔转译</h3>
              <p>不是替你说话，是帮你理解之后自己选择怎么说</p>
            </div>
            <div class="benefit-card">
              <img class="space-card-icon" src="/icon-energy.png" alt="" width="32" height="32">
              <h3>关系能量</h3>
              <p>每次沟通化为可视化能量，滋养你的生命空间</p>
            </div>
            <div class="benefit-card">
              <img class="space-card-icon" src="/icon-forms.png" alt="" width="32" height="32">
              <h3>不同关系不同形态</h3>
              <p>家人是树、伴侣是花、朋友是游鱼，各有生命</p>
            </div>
            <div class="benefit-card">
              <img class="space-card-icon" src="/icon-companion.png" alt="" width="32" height="32">
              <h3>长期陪伴</h3>
              <p>不只看一次，是陪你在人际关系中持续成长</p>
            </div>
          </div>
        </div>

        <!-- ③ 关系花园 -->
        <div class="space-section">
          <h2 class="space-section-title">关系花园</h2>
          <div class="space-card growth-card">
            <img class="space-card-icon" src="/icon-garden.png" alt="" width="32" height="32">
            <p>每一次对话，都会留下痕迹。它们化作<strong>关系能量</strong>，滋养属于你的生命空间。</p>
            <p>家人是一棵古树，承载岁月的根系；<br>伴侣是一朵花，需要被看见与呵护；<br>朋友是一群游鱼，在陪伴中靠近又远游。</p>
            <p>它们不是冰冷的数据，而是会随着你的理解、表达和改变，<strong>慢慢生长的关系生命</strong>。</p>
            <p class="growth-ending">知间不评判你的过去，只是陪你看见——<br>你与每个人之间，正在如何靠近。</p>
          </div>
        </div>

        <!-- ④ 加入知间 -->
        <div class="space-section signup-section">
          <h2 class="space-section-title">种下你的种子</h2>
          <p class="signup-desc">每一次理解，都在滋养你的关系花园</p>
          <button class="btn-primary btn-signup" onclick="document.getElementById('space-screen').classList.remove('active');document.getElementById('account-screen').classList.add('active')">种下我的种子</button>
          <p class="signup-link">已有种子？<a href="#" onclick="document.getElementById('space-screen').classList.remove('active');document.getElementById('login-screen').classList.add('active')">回到我的花园</a></p>
        </div>

        <p class="footer-brand">知间 InBetween</p>
      </div>
    </main>

    <!-- ====== 种下种子（注册） ====== -->
    <main id="account-screen" class="screen">
      <div class="account-container">
        <div class="account-hero">
          <h1 class="account-title">种下你的种子</h1>
          <p class="account-desc">每一次理解，都会让它生根发芽</p>
        </div>
        <div class="account-form">
          <div class="form-field">
            <label>邮箱</label>
            <input type="email" placeholder="输入你的邮箱地址">
          </div>
          <div class="form-field">
            <label>密码</label>
            <input type="password" placeholder="设置一个密码">
          </div>
          <div class="form-field">
            <label>确认密码</label>
            <input type="password" placeholder="再输入一次密码">
          </div>
          <button class="btn-primary btn-signup" onclick="showToast('账号功能即将上线')">种下我的种子</button>
          <p class="signup-link">已有种子？<a href="#" onclick="document.getElementById('account-screen').classList.remove('active');document.getElementById('login-screen').classList.add('active')">回到我的花园</a></p>
        </div>
      </div>
    </main>

    <!-- ====== 回到花园（登录） ====== -->
    <main id="login-screen" class="screen">
      <div class="account-container">
        <div class="account-hero">
          <h1 class="account-title">回到你的花园</h1>
          <p class="account-desc">你的关系生命，一直在等你</p>
        </div>
        <div class="account-form">
          <div class="form-field">
            <label>邮箱</label>
            <input type="email" placeholder="输入你的邮箱地址">
          </div>
          <div class="form-field">
            <label>密码</label>
            <input type="password" placeholder="输入你的密码">
          </div>
          <button class="btn-primary btn-signup" onclick="showToast('登录功能即将上线')">回到花园</button>
          <p class="signup-link">还没有种子？<a href="#" onclick="document.getElementById('login-screen').classList.remove('active');document.getElementById('account-screen').classList.add('active')">种下我的种子</a></p>
        </div>
      </div>
    </main>

    <!-- ====== 关系花园 ====== -->
    <main id="garden-screen" class="screen">
      <canvas id="gardenCanvas"></canvas>
      <div class="garden-container">
        <div class="garden-hero">
          <h1 class="garden-title">我的关系花园</h1>
          <p class="garden-subtitle">每一次沟通，都在滋养一段关系</p>
        </div>
        <!-- 关系生命体 -->
        <div class="garden-ecosystem">
          <div class="garden-entity family-tree">
            <div class="entity-visual">🌳</div>
            <div class="entity-info">
              <h3>家人</h3>
              <p class="entity-status">古树 · 根基深厚</p>
              <div class="entity-bar"><div class="entity-fill" style="width:72%"></div></div>
            </div>
          </div>
          <div class="garden-entity partner-flower">
            <div class="entity-visual">🌺</div>
            <div class="entity-info">
              <h3>伴侣</h3>
              <p class="entity-status">花期 · 正在绽放</p>
              <div class="entity-bar"><div class="entity-fill" style="width:85%"></div></div>
            </div>
          </div>
          <div class="garden-entity friend-fish">
            <div class="entity-visual">🐟</div>
            <div class="entity-info">
              <h3>朋友</h3>
              <p class="entity-status">鱼群 · 自在游弋</p>
              <div class="entity-bar"><div class="entity-fill" style="width:60%"></div></div>
            </div>
          </div>
          <div class="garden-entity self-tree">
            <div class="entity-visual">🌱</div>
            <div class="entity-info">
              <h3>自我</h3>
              <p class="entity-status">生长中 · 第 12 天</p>
              <div class="entity-bar"><div class="entity-fill" style="width:45%"></div></div>
            </div>
          </div>
        </div>
        <!-- 季节 -->
        <div class="garden-season">
          <p>当前季节：<span>春 · 生长季</span></p>
        </div>
      </div>
    </main>

    <!-- ====== 输入页 ====== -->
    <main id="input-screen" class="screen">
      <div class="hero">
        <h1 class="brand">知间</h1>
        <p class="subtitle">理解人与人之间</p>
        <p class="greeting">我在听。把对话发给我。</p>
      </div>
      <div class="input-card">
        <div class="tab-bar">
          <button class="tab active" data-tab="paste">
            <img src="/icon-chat.png" alt="" width="20" height="20" class="tab-icon"> 粘贴对话
          </button>
          <button class="tab" data-tab="image">
            <img src="/icon-screenshot.png" alt="" width="20" height="20" class="tab-icon"> 上传截图 <span class="coming-soon-tag">即将上线</span>
          </button>
          <button class="tab" data-tab="audio">
            <img src="/icon-record.png" alt="" width="20" height="20" class="tab-icon"> 录制对话 <span class="coming-soon-tag">即将上线</span>
          </button>
        </div>
        <div id="tab-paste" class="tab-content active">
          <textarea id="text-input" placeholder="把聊天记录粘贴到这里……&#10;&#10;格式示例：&#10;我：你为什么不回我消息&#10;TA：刚刚在忙" rows="10"></textarea>
        </div>
        <div id="tab-image" class="tab-content">
          <div id="drop-zone" class="drop-zone">
            <img src="/icon-screenshot.png" alt="" width="48" height="48" class="drop-icon-img">
            <p>点击或拖拽上传聊天截图</p>
            <p class="drop-hint">支持 JPG、PNG，分析后立即删除原始文件</p>
            <input type="file" id="image-input" accept="image/*" hidden />
            <button id="upload-btn" class="btn-secondary" type="button">选择图片</button>
          </div>
        </div>
        <div id="tab-audio" class="tab-content">
          <div class="audio-placeholder">
            <img src="/icon-record.png" alt="" width="48" height="48" class="audio-icon-img">
            <h3>录制或上传对话录音</h3>
            <p class="audio-note">即将上线：自动区分说话人、转写文字、分析情绪变化</p>
          </div>
        </div>
        <div id="identity-section" class="identity-section hidden">
          <p class="identity-label">在这段对话里，你是哪一方？</p>
          <div class="identity-buttons">
            <button class="identity-btn" data-role="A">我是 A 方</button>
            <button class="identity-btn" data-role="B">我是 B 方</button>
            <button class="identity-btn" data-role="auto">帮我判断</button>
          </div>
          <p id="identity-hint" class="identity-hint"></p>
        </div>
        <div class="privacy-note">你的对话将被安全加密。未注册用户分析后立即删除，注册用户可随时导出或一键删除。</div>
      </div>
      <button id="analyze-btn" class="btn-primary" disabled>开始分析</button>
      <p id="input-hint" class="input-hint">请输入至少 5 条对话</p>
    </main>

    <!-- ====== 加载/报告 ====== -->
    <div id="loading-screen" class="screen">
      <div class="loading-card">
        <p class="loading-msg" id="lm1">我正在理解<br>你们刚才说的话……</p>
        <p class="loading-msg" id="lm2">正在寻找<br>真正让情绪升级的地方……</p>
        <p class="loading-msg" id="lm3">正在尝试<br>站在双方角度理解……</p>
        <p class="loading-msg" id="lm4">快好了……</p>
      </div>
    </div>

    <main id="report-screen" class="screen">
      <div class="report-container">
        <section id="screen-1" class="report-screen screen-1"><h2 class="section-label">🎯 核心洞察</h2><div id="core-insight" class="core-insight"></div></section>
        <section id="screen-responsibility" class="report-screen screen-responsibility hidden"><h2 class="section-label">📊 本次冲突行为贡献度</h2><div id="responsibility-container"></div></section>
        <section id="screen-2" class="report-screen screen-2"><h2 class="section-label">🌍 你们各自的世界</h2><div id="dual-columns" class="dual-columns"></div><div id="gap-annotation" class="gap-annotation"></div></section>
        <section id="screen-3" class="report-screen screen-3"><h2 class="section-label">🎙️ 对话回放 · 知间解说</h2><div id="replay-container" class="replay-container"></div></section>
        <section id="screen-4" class="report-screen screen-4"><h2 class="section-label">🔄 如果重来</h2><div id="what-if-container" class="what-if-container"></div></section>
        <section id="screen-emotion" class="report-screen screen-emotion hidden"><h2 class="section-label">📈 吵架后的情绪画像</h2><div id="emotion-container"></div></section>
        <section id="screen-relief" class="report-screen screen-relief hidden"><h2 class="section-label">🪴 试试这些方法</h2><div id="relief-container"></div><p id="relief-note" class="relief-note hidden"></p></section>
        <section id="screen-5" class="report-screen screen-5"><h2 class="section-label">💬 破局与分享</h2><div id="icebreaker-container" class="icebreaker-container"></div><div id="share-section" class="share-section"><button id="share-btn" class="btn-primary">📤 分享 TA 的那一半</button><p class="share-hint">TA 只会看到自己的分析部分。你的隐私是安全的。</p></div></section>
        <footer class="report-footer"><button id="new-analysis-btn" class="btn-secondary">🔄 开始新的分析</button><p class="register-teaser">🌱 想记住这次分析，看到自己的成长？<a href="#" id="register-teaser-link">创建账号</a></p><p class="footer-brand">知间 InBetween · 理解人与人之间</p></footer>
      </div>
    </main>

    <div id="toast" class="toast hidden"></div>
  </div>
  <script type="module" src="/src/main.js"></script>
</body>
</html>
